FAVORIOT_API_KEY= "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VybmFtZSI6InB1YWppbW15MDIiLCJyZWFkX3dyaXRlIjp0cnVlLCJpYXQiOjE3ODEwODA4MjB9.CGgypv4VlgZOE_8d95mdU-c25WwH-DGBeK6F7Pve9T4"
FAVORIOT_DEVICE_DEVELOPER_ID= "deviceDefault@puajimmy02"
FAVORIOT_URL=https://apiv2.favoriot.com/v2/streams

DHT_PIN=D4
SOIL_CHANNEL=0
RELAY_PIN=16
PUMP_SELF_TEST=false
PUMP_SELF_TEST_ON_SECONDS=5
PUMP_SELF_TEST_OFF_SECONDS=2
READ_INTERVAL_SECONDS=600
ML_CONTROL_MODE=recommend
DEBUG_MODE=false
SIMULATION_MODE=false
RUN_ONCE=false

# MCP3008 value calibration. Most analog soil sensors are high when dry and low when wet.
SOIL_DRY_RAW=1.0
SOIL_WET_RAW=5.1

DRY_PERCENT=30
WET_PERCENT=70
CSV_FILE=plant_data.csv

# SARIMAX soil moisture forecasting. Train manually with:
# python -m plant_monitor.train_forecast_model
FORECAST_MODEL_PATH=models/soil_forecast_sarimax.joblib
FORECAST_MIN_ROWS=24
FORECAST_RECENT_AVERAGE_HOURS=1
FORECAST_HORIZONS_HOURS=4,6,8
FORECAST_DRY_PERCENT=30

# Old starter classifier data can stay in the repo for explanation/comparison,
# but SARIMAX should train from real timestamped plant_data.csv.
TRAINING_CSV_FILE=data/training_smart_agriculture.csv

# Local simulation values for debugging without Raspberry Pi hardware.
SIM_TEMPERATURE=32
SIM_HUMIDITY=55
SIM_SOIL_VALUE=45

# Streamlit dashboard auto-refresh. Set to 0 to disable.
STREAMLIT_REFRESH_SECONDS=10

# Telegram notifications.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID_HERE
NOTIFICATION_COOLDOWN_SECONDS=1800
TELEGRAM_STATE_FILE=.telegram_state.json
