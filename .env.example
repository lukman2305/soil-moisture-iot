FAVORIOT_API_KEY=PASTE_YOUR_NEW_API_KEY_HERE
FAVORIOT_DEVICE_DEVELOPER_ID=PASTE_YOUR_DEVICE_DEVELOPER_ID_HERE
FAVORIOT_URL=https://apiv2.favoriot.com/v2/streams

DHT_PIN=D4
SOIL_CHANNEL=0
RELAY_PIN=18
READ_INTERVAL_SECONDS=600

# MCP3008 value calibration. Most analog soil sensors are high when dry and low when wet.
SOIL_DRY_RAW=1.0
SOIL_WET_RAW=0.0

DRY_PERCENT=30
WET_PERCENT=70
CSV_FILE=plant_data.csv
