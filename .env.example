FAVORIOT_API_KEY=PASTE_YOUR_NEW_API_KEY_HERE
FAVORIOT_DEVICE_DEVELOPER_ID=PASTE_YOUR_DEVICE_DEVELOPER_ID_HERE
FAVORIOT_URL=https://apiv2.favoriot.com/v2/streams

DHT_PIN=D4
SOIL_CHANNEL=0
RELAY_PIN=18
READ_INTERVAL_SECONDS=600
ML_CONTROL_MODE=recommend
DEBUG_MODE=false
SIMULATION_MODE=false
RUN_ONCE=false

# MCP3008 value calibration. Most analog soil sensors are high when dry and low when wet.
SOIL_DRY_RAW=1.0
SOIL_WET_RAW=0.0

DRY_PERCENT=30
WET_PERCENT=70
CSV_FILE=plant_data.csv

# Machine learning files. Use Kaggle first, then switch TRAINING_CSV_FILE to plant_data.csv after collecting real data.
MODEL_PATH=models/dryness_model.joblib
TRAINING_CSV_FILE=data/training_smart_agriculture.csv

# Local simulation values for debugging without Raspberry Pi hardware.
SIM_TEMPERATURE=32
SIM_HUMIDITY=55
SIM_SOIL_VALUE=45

# Telegram notifications.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID_HERE
NOTIFICATION_COOLDOWN_SECONDS=1800
TELEGRAM_STATE_FILE=.telegram_state.json
